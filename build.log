D:\proyectsVS\BootScope>if not exist build mkdir build 

D:\proyectsVS\BootScope>set MAJOR=0 

D:\proyectsVS\BootScope>set MINOR=0 

D:\proyectsVS\BootScope>set PATCH=0 

D:\proyectsVS\BootScope>for /F "tokens=1,2,3 delims=." %a in (VERSION) do (
set MAJOR=%a  
 set MINOR=%b  
 set PATCH=%c 
) 

D:\proyectsVS\BootScope>(
set MAJOR=0  
 set MINOR=2  
 set PATCH=0 
) 

D:\proyectsVS\BootScope>if "2" == "" set MINOR=0 

D:\proyectsVS\BootScope>if "0" == "" set PATCH=0 

D:\proyectsVS\BootScope>where gcc  1>nul 2>nul 

